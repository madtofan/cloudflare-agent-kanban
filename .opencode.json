{
  "mcp": {
    "context7": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {}
    },
    "shadcn": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "enabled": true,
      "environment": {}
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.inkeep.com/better-auth/mcp",
      "enabled": true
    },
    "kanban": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:KANBAN_MCP_TOKEN}"
      }
    }
  }
}
